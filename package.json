{
  "name": "dennan_ux",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "storefront",
    "admin"
  ],
  "scripts": {
    "dev:storefront": "npm run dev -w storefront",
    "dev:admin": "npm run dev -w admin",
    "dev:convex": "convex dev",
    "dev:all": "concurrently \"npm run dev:convex\" \"npm run dev:storefront\" \"npm run dev:admin\"",
    "build:storefront": "npx convex deploy && npm run build -w storefront",
    "build:admin": "npx convex deploy && npm run build -w admin",
    "lint": "eslint ."
  },
  "dependencies": {
    "@auth/core": "^0.37.0",
    "@convex-dev/auth": "^0.0.92",
    "convex": "^1.37.0",
    "jose": "^6.2.3",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "json-server": "^1.0.0-beta.15",
    "vite": "^8.0.10"
  }
}
